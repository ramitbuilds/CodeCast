# =================================================================
# CodeCast Configuration (.env)
# =================================================================

# Agent Router API (https://agentrouter.org)
# Supports any model routed through Agent Router (e.g. deepseek-v4-flash, claude-sonnet-4-5-20250929, gpt-4o-mini)
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENTROUTER_MODEL=deepseek-v4-flash

# Optional: ElevenLabs Voice Narration (falls back to Windows SAPI speech if omitted)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
